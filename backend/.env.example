# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (Render, Railway, Neon, Azure, local...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agriopportunity
# Set to true for hosted databases that require SSL (Render external URL, Neon, Azure)
DATABASE_SSL=false

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed web origins, or * for any (mobile apps send no Origin)
CORS_ORIGIN=*

# Seed synthetic demo data on start if the database is empty
SEED_ON_START=true
